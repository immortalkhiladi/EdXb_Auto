# Copy to backend/.env for LOCAL DEVELOPMENT. Never commit the real file.
# Render does NOT use this file: set the same names as environment variables on the service (see render.yaml and
# docs/RENDER_DEPLOYMENT.md).

# --- local PostgreSQL (initial local setup) ---
DB_ENGINE=postgres
DB_NAME=myapp_db
DB_USER=myapp_user
DB_PASSWORD=MyApp@123
DB_HOST=localhost
DB_PORT=5432
# Quick start without PostgreSQL (SQLite file):  DB_ENGINE=sqlite

# --- local app settings ---
DJANGO_SETTINGS_MODULE=config.settings.local
# DJANGO_SECRET_KEY=            # optional locally: a random key is generated into data/.dev_secret_key
# ADMIN_MFA_REQUIRED=true       # try the admin MFA flow locally

# --- forgot password (reset link by email) ---
# Without EMAIL_HOST the reset email is printed in the server console (local development only).
# FRONTEND_URL=http://localhost:3000     # base URL placed in the reset link
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=EDGAR Agents LLC <no-reply@example.com>
# PASSWORD_RESET_MINUTES=30              # link lifetime
# PASSWORD_RESET_REVEAL_ACCOUNT=true     # false = never say whether an email has an account
