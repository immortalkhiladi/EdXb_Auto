# Copy to frontend/.env.production before `npm run build` for split hosting (UI and API on different origins; the default Render setup serves both from one origin and needs no file).
# Public value (baked into the JavaScript) - never put secrets in VITE_* variables.
VITE_API_BASE_URL=https://api.example.com/api

# --- forgot password (Render environment variables) ---
